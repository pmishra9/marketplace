{
  "name": "marketplace-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for Marketplace: Node.js Backend, React Marketplace Frontend, and AdminJS Admin Panel",
  "workspaces": [
    "backend",
    "market",
    "admin"
  ],
  "scripts": {
    "dev": "npm run db:migrate && concurrently -n backend,admin,market -c blue,magenta,cyan \"npm run dev --workspace=backend\" \"npm run dev --workspace=admin\" \"npm run dev --workspace=market\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:admin": "npm run dev --workspace=admin",
    "dev:market": "npm run dev --workspace=market",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:migrate:dev": "npm run db:migrate:dev --workspace=backend",
    "db:generate": "npm run db:generate --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "db:seed:auth": "npm run db:seed:auth --workspace=backend",
    "db:backfill:order-owners": "npm run db:backfill:order-owners --workspace=backend",
    "db:reset": "npm run db:reset --workspace=backend",
    "resetdb": "npm run db:reset --workspace=backend",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
