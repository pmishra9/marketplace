{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "node prisma/seed.js",
    "db:seed:auth": "node prisma/seedAuthUser.js",
    "db:backfill:order-owners": "node prisma/backfillOrderOwners.js",
    "billing:run": "node src/workers/billSubscriptions.js",
    "db:reset": "prisma migrate reset --force",
    "resetdb": "npm run db:reset"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "prisma": "^6.4.1"
  }
}
