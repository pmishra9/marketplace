# ==========================================
# Marketplace Monorepo Environment Variables
# ==========================================

# Database Configuration (PostgreSQL: psql marketplace)
DATABASE_URL="postgresql://rabi@localhost:5432/marketplace"

# Backend Configuration (backend/.env)
BACKEND_PORT=4000
NODE_ENV=development

# AdminJS Configuration (admin/.env)
ADMIN_PORT=3001
ADMIN_EMAIL=admin@marketplace.local
ADMIN_PASSWORD=adminsecret
SESSION_SECRET=marketplace-admin-session-secret-change-in-production

# Market Frontend Configuration (market/.env)
VITE_API_URL=http://localhost:4000
